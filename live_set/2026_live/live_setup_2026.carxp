  </Connection>
  <Connection>
   <Source>AMS-24 Analog Stereo:capture_FR</Source>
   <Target>SuperCollider:in_2</Target>
  </Connection>
  <Connection>
   <Source>Carla:CHOWTapeModel:Audio Output 2</Source>
   <Target>Carla:LSP Clipper Stereo:Input R</Target>
  </Connection>
  <Connection>
   <Source>Carla:CHOWTapeModel:Audio Output 1</Source>
   <Target>Carla:LSP Clipper Stereo:Input L</Target>
